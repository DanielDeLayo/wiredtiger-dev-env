{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Wiredtiger",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "ninja -j 4",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Mongo",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "bazel build install-devcore --verbose_failures",
            "options": {
                "cwd": "${workspaceFolder:mongodb}/"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Mongo Integration Test",
            "type": "shell",
            "command": "bash -c \"bazel build //src/mongo/executor:executor_integration_test && source python3-venv/bin/activate && printf 'test_kind: cpp_integration_test\\n\\nselector:\\n  roots:\\n    - bazel-bin/src/mongo/executor/executor_integration_test\\n\\nexecutor:\\n  archive:\\n    hooks:\\n      - ValidateCollections\\n  config:\\n    program_options: {}\\n  hooks:\\n    - class: ValidateCollections\\n  fixture:\\n    class: MongoDFixture\\n    mongod_options:\\n      set_parameters:\\n        enableTestCommands: 1\\n' > buildscripts/resmokeconfig/suites/executor_suite.yml && ./buildscripts/resmoke.py run --suites=executor_suite --dbpathPrefix=${workspaceFolder:mongodb}/.tmp/db bazel-bin/src/mongo/executor/executor_integration_test\"",
            "options": {
                "cwd": "${workspaceFolder:mongodb}/"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run Mongo Unit Test",
            "type": "shell",
            "command": "bazel test --test_tag_filters=mongo_unittest //src/mongo/...",
            "options": {
                "cwd": "${workspaceFolder:mongodb}/"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "CMake Wiredtiger",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            //"command": "cmake -DCMAKE_BUILD_TYPE=Debug ../.",
            //-DCMAKE_CXX_FLAGS='-fsanitize=address' -DCMAKE_C_FLAGS='-fsanitize=address'
            "command": "cmake -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo  -DHAVE_ANALYZE_CACHE=1 -DENABLE_STATIC=1 -DCMAKE_EXPORT_COMPILE_COMMANDS=ON ../. && mv compile_commands.json ..",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run ctest",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            //"command": "ctest -j4 --rerun-failed --output-on-failure",
            "command": "ctest -j1 -E 'test_syscall|ex_tiered|disagg|wt7989'",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run small ctests",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            //"command": "ctest -j4 --rerun-failed --output-on-failure",
            "command": "ctest -j 1 -I 1,10,1 --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run failed ctests",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "ctest -j1 -E 'test_syscall|ex_tiered|disagg|wt7989' --rerun-failed --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run python tests",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "python3 ../test/suite/run.py -j 4 -v 2 checkpoint",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run WT_TEST tests",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "../bench/wtperf/wtperf -O ../../bench/wtperf/runners/medium-btree-large.wtperf",
            //"command": "../bench/wtperf/wtperf -O ../../bench/wtperf/runners/500m-btree-50r50u.wtperf",
            "options": {
                "cwd": "${workspaceFolder:wiredtiger}/build/Testing/"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}